# Generate a private random token before starting the backend.
DOJ_INTERNAL_TOKEN=replace-with-a-random-64-character-token
DOJ_REVIEW_PROVIDER=mock

# Match Docker RootDir and the volume names in deploy/compose.override.yml.
HOST_CODE_PATH=/var/lib/docker/volumes/interviewjudge-codes/_data
HOST_PROBLEM_CODE_PATH=/var/lib/docker/volumes/interviewjudge-problem-codes/_data

# Optional real Provider configuration; keep credentials in .env.local only.
DOJ_REVIEW_BASE_URL=
DOJ_REVIEW_MODEL=
OPENAI_API_KEY=
